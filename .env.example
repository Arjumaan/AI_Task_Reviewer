# ==============================================================================
# TASK REVIEWER AI — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
ENV=development
DEBUG=true
PROJECT_NAME="Task Reviewer AI"
DEFAULT_TIMEZONE=Asia/Kolkata

# Security & Authentication
# Generate a secure key in production: openssl rand -hex 32
SECRET_KEY=change-me-in-production-super-secret-key-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=120
ALGORITHM=HS256

# Database Configuration
# Local development default: SQLite with foreign key enforcement
DATABASE_URL=sqlite+aiosqlite:///./storage/reviewer.db
# PostgreSQL for production / Docker Compose:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/task_reviewer

# Local AI Inference (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=60

# Audio & Speech Services
# Zero-cost local TTS (Piper / pyttsx3) and STT (faster-whisper)
TTS_ENGINE=pyttsx3
TTS_VOICE_PREFERENCE=en_IN
STT_MODEL=base.en
VIRTUAL_AUDIO_DEVICE="Line 1 (Virtual Audio Cable)"

# Object Storage & Retention
UPLOAD_STORAGE_PATH=./storage/uploads
RECORDING_STORAGE_PATH=./storage/recordings
RECORDING_RETENTION_DAYS=90

# Google Services Integration (External Proprietary Dependencies)
# Note: Google Calendar and Gmail are external, proprietary Google APIs.
# Set GOOGLE_DRY_RUN=true to test the entire lifecycle offline without Google credentials.
GOOGLE_DRY_RUN=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GOOGLE_REFRESH_TOKEN=

# Review Policy Configuration
MAX_REVISION_ROUNDS=3
ENABLE_AUTONOMOUS_PASS=true
AUTO_RECORDING_CONSENT_REQUIRED=true
SANDBOX_EXECUTION_TIMEOUT_SECONDS=10

# MeetingBaas & Speaking Bot Integration
MEETING_BAAS_API_KEY=your_meeting_baas_api_key_here
MEETING_BAAS_BASE_URL=https://api.meetingbaas.com
MEETING_BAAS_SPEAKING_URL=https://speaking.meetingbaas.com

# Cartesia Humanized Neural Voice TTS
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_VOICE_ID=your_cartesia_voice_id_here
CARTESIA_VOICE_NAME="Subha (Indian English)"
CARTESIA_MODEL_ID=sonic-3.6

